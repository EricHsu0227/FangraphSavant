{
  // Cloudflare Worker serving the static Vite build (Workers static assets).
  // Workers Builds redeploys on every push to main — including the nightly data commits.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fangraphsavant",
  "compatibility_date": "2026-05-15",
  "assets": { "directory": "./dist" },
  "build": { "command": "npm run build" }
}
